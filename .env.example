# Formspree: alıcı adresini sağlayıcı hesabında mkdigitalsystems@gmail.com olarak ayarlayın.
# formspree.io'da form oluşturup e-posta olarak mkdigitalsystems@gmail.com ekleyin, Form ID'yi buraya yazın.
NEXT_PUBLIC_FORMSPREE_FORM_ID=

# (Formspree kullanmıyorsanız) Gmail SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=YOUR_APP_PASSWORD

MAIL_TO=mkdigitalsystems@gmail.com
MAIL_FROM=noreply@yourdomain.com

# Final canonical HTTPS origin. Leave empty during local design/preview work.
# Without this value, the site remains noindex and robots disallows crawling.
SITE_URL=
NEXT_PUBLIC_CONTACT_EMAIL=mkdigitalsystems@gmail.com
NEXT_PUBLIC_WHATSAPP_NUMBER=905456597551
# Optional call number; defaults to the configured WhatsApp number.
NEXT_PUBLIC_PHONE_NUMBER=905456597551
# Set NEXT_PUBLIC_FORMSPREE_FORM_ID=disabled to explicitly use SMTP instead.
